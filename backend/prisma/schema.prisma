generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SenderStatus {
  active
  broken
}

enum EmailStatus {
  scheduled
  sending
  sent
  failed
  needs_check
}

enum SlackStatus {
  active
  broken
}

model User {
  id        String   @id @default(uuid())
  googleId  String   @unique
  email     String
  name      String
  avatarUrl String?
  createdAt DateTime @default(now())

  senders   Sender[]
  campaigns Campaign[]
  slack     SlackIntegration?
}

// A "From" mailbox (an Ethereal account) owned by one user.
model Sender {
  id          String       @id @default(uuid())
  userId      String
  email       String       @unique
  smtpUser    String
  smtpPassEnc String
  smtpHost    String
  smtpPort    Int
  imapHost    String
  imapPort    Int
  status      SenderStatus @default(active)
  createdAt   DateTime     @default(now())

  user      User       @relation(fields: [userId], references: [id])
  campaigns Campaign[]
  emails    Email[]

  @@index([userId, status])
}

model Campaign {
  id          String   @id @default(uuid())
  userId      String
  senderId    String
  subject     String
  body        String // plain text: the text part of each email, previews and search
  html        String? // the formatted version from the editor; null for plain-text campaigns
  startAt     DateTime
  delayMs     Int
  hourlyLimit Int
  createdAt   DateTime @default(now())

  user        User         @relation(fields: [userId], references: [id])
  sender      Sender       @relation(fields: [senderId], references: [id])
  emails      Email[]
  attachments Attachment[]

  @@index([userId, createdAt])
}

/// Files sent with every email of a campaign. Small by design (3 files, 2 MB in total), so they live in Postgres.
model Attachment {
  id          String   @id @default(uuid())
  campaignId  String
  filename    String
  contentType String
  size        Int
  data        Bytes
  createdAt   DateTime @default(now())

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId])
}

// One row per recipient. id doubles as the BullMQ jobId.
model Email {
  id             String      @id @default(uuid())
  campaignId     String
  userId         String
  senderId       String
  toEmail        String
  scheduledAt    DateTime
  status         EmailStatus @default(scheduled)
  attempts       Int         @default(0)
  claimedAt      DateTime?
  sentAt         DateTime?
  messageId      String?
  previewUrl     String?
  error          String?
  version        Int         @default(1)
  indexedVersion Int         @default(0)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  campaign Campaign @relation(fields: [campaignId], references: [id])
  sender   Sender   @relation(fields: [senderId], references: [id])

  @@unique([campaignId, toEmail])
  @@index([userId, status, scheduledAt])
  @@index([senderId, status, scheduledAt])
  @@index([status])
}

model SlackIntegration {
  userId         String      @id
  teamId         String
  teamName       String
  channel        String
  channelId      String
  webhookUrlEnc  String
  accessTokenEnc String
  status         SlackStatus @default(active)
  lastError      String?
  connectedAt    DateTime    @default(now())

  user User @relation(fields: [userId], references: [id])
}

// Append-only: a DB trigger (see migration audit_append_only) rejects UPDATE/DELETE.
model AuditEvent {
  id         BigInt   @id @default(autoincrement())
  userId     String
  campaignId String?
  emailId    String?
  type       String
  fromStatus String?
  toStatus   String?
  actor      String
  attempt    Int?
  data       Json     @default("{}")
  createdAt  DateTime @default(now())

  @@index([emailId, createdAt])
  @@index([campaignId, createdAt])
  @@index([userId, createdAt])
}

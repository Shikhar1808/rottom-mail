# Demo limits (no secrets): 1-minute windows and a cap of 5, so the limiter shows up in minutes, not hours.
# Loaded on top of backend/.env by `npm run demo:api` / `demo:worker` / `demo:worker:global`. Values here win.
RATE_LIMIT_MODE=per_sender
RATE_LIMIT_WINDOW_MS=60000
MAX_EMAILS_PER_HOUR_PER_SENDER=5
MAX_EMAILS_PER_HOUR=5

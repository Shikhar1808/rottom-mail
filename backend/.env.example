# --- infra (docker compose) ---
DATABASE_URL=postgresql://rottom:rottom@localhost:5432/rottom
REDIS_URL=redis://localhost:6380
ELASTICSEARCH_URL=http://localhost:9200

# --- the one public origin (Vite dev server locally, Caddy in prod) ---
APP_URL=https://localhost:5173
PORT=4000

# --- secrets ---
# 32 random bytes, base64: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=https://localhost:5173/api/slack/callback

# --- scheduler ---
RATE_LIMIT_MODE=per_sender
WORKER_CONCURRENCY=5
WORKER_QUEUES=emails,search-sync,notifications
MIN_DELAY_BETWEEN_SENDS_MS=2000
MAX_EMAILS_PER_HOUR=200
MAX_EMAILS_PER_HOUR_PER_SENDER=200
RATE_LIMIT_WINDOW_MS=3600000

# --- senders / smtp ---
SMTP_MODE=ethereal
DEFAULT_SENDERS_PER_USER=2
MAX_SENDERS_PER_USER=5

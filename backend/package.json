{
  "name": "rottom-mail-backend",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev:api": "tsx watch src/server.ts",
    "dev:worker": "tsx watch src/workers/index.ts",
    "dev:session": "tsx src/scripts/dev-session.ts",
    "dev:slack-webhook": "tsx src/scripts/dev-slack-webhook.ts",
    "build": "eslint src && tsc",
